#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if command -v python >/dev/null 2>&1; then
    python .github/scripts/fix_whitespace.py --staged
elif command -v python3 >/dev/null 2>&1; then
    python3 .github/scripts/fix_whitespace.py --staged
else
    echo "pre-commit: Python 3 is required for the Markdown whitespace hook." >&2
    exit 1
fi

git diff --cached --check

# syntax=docker/dockerfile:1
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG BASE_IMAGE_ID
LABEL org.emotionalcompany.base-image-id=${BASE_IMAGE_ID}

WORKDIR /root

# The official start.sh is kept byte-identical; the dual routing lives in
# participant/run_inference.py and the vLLM launcher wrapper instead.
ENV EVALUATION_BACKEND=openai_compatible
ENV VLLM_BIN=/usr/local/bin/emotionalcompany-vllm
ENV EVALUATION_INFERENCE_CONFIG=/root/participant/configs/inference_config.json

COPY participant/start_official.sh /root/participant/start.sh
COPY participant/run_inference.py /root/participant/run_inference.py
COPY participant/final_dual_inference.py /root/participant/final_dual_inference.py
COPY participant/configs/inference_config.json /root/participant/configs/inference_config.json
COPY scripts/e02_vllm_probe.py /root/scripts/e02_vllm_probe.py
COPY configs/deployment/final_dual_docker.json /root/configs/deployment/final_dual_docker.json
COPY docker/final_dual/entrypoint.sh /usr/local/bin/emotionalcompany-final-dual-entrypoint
COPY docker/final_dual/entrypoint_args.sh /usr/local/bin/entrypoint_args.sh
COPY docker/final_dual/emotionalcompany_vllm_wrapper.py /usr/local/bin/emotionalcompany-vllm
COPY src/inference/final_dual_protocol.py /root/src/inference/final_dual_protocol.py
COPY src/inference/final_dual_vllm.py /root/src/inference/final_dual_vllm.py
COPY report/main.pdf /root/report/main.pdf

RUN chmod 0755 /root/participant/start.sh \
      /usr/local/bin/emotionalcompany-final-dual-entrypoint \
      /usr/local/bin/entrypoint_args.sh \
      /usr/local/bin/emotionalcompany-vllm \
    && test -s /root/report/main.pdf \
    && test -x /opt/conda/envs/conda_env/bin/python \
    && test -x /opt/conda/envs/conda_env/bin/vllm \
    && test -f /root/participant/model/config.json \
    && test -s /root/participant/adapters/profile/adapter_model.safetensors \
    && test -s /root/participant/adapters/emotion-response/adapter_model.safetensors \
    && test -f /root/configs/deployment/final_dual_docker.json
